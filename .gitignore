# Gradle
.gradle/
build/
build-logic/build/
!gradle/wrapper/gradle-wrapper.jar

# IDE
.idea/
*.iml
.vscode/

# Node. The studio itself lives in the BRE_UI repository; this covers any local tooling.
node_modules/
dist/

# Local secrets. Nexus credentials belong in ~/.gradle/gradle.properties or
# the environment, never in the repository.
local.properties
*.local.properties

# Tooling scratch
.aitdp/

# Local preview server output and screenshots
.playwright-mcp/

# Gradle Kotlin compiler session state
.kotlin/

# Jazzer's generated corpus. Inputs the fuzzer discovered and keeps for the next run — machine
# output, regenerated freely, and written DURING a run, so staging it races the fuzzer.
# A crash is different and IS committed: it lives under src/test/resources/.../<TestClass>/<method>/
# and becomes a permanent regression case.
#
# It must stay ignored for a second reason found in M6-02: a run leaves entries behind, and the
# next ORDINARY build walks them as seeds — so a corpus file removed between the walk and the read
# fails the whole test task with NoSuchFileException, in a module nobody was fuzzing.
.cifuzz-corpus/

# devstack working directory: local keys, bundles and logs. Never committed.
devstack/var/
