[
  {
    "id": "P-01",
    "description": "Step statuses [FAIL, ERROR, DEVIATION] give decision DECLINE: FAIL in S wins over everything, so a FAIL plus an ERROR is never softened to REFER (4.8)",
    "asOf": "2026-10-01",
    "scope": "APPLICATION",
    "facts": {
      "application": {
        "applicationRef": "APP-2026-000123",
        "productLine": "MFI_JLG",
        "stage": "CREDIT_UW",
        "requestedAmount": "300000.00",
        "one": "1",
        "zero": "0",
        "exposure": "210000"
      }
    },
    "policy": {
      "irVersion": 1,
      "policy": {
        "tenantId": "t_acme",
        "code": "P_PRECEDENCE",
        "version": 1,
        "productLines": [
          "MFI_JLG"
        ],
        "stage": "CREDIT_UW"
      },
      "assets": {
        "authorityMatrix": {
          "code": "P_DOP",
          "version": 1,
          "routingMode": "HIGHEST_ONLY",
          "levels": [
            {
              "levelCode": "L1",
              "rank": 1
            },
            {
              "levelCode": "L2",
              "rank": 2
            },
            {
              "levelCode": "L3",
              "rank": 3
            }
          ],
          "entries": [
            {
              "entryNo": 1,
              "deviationType": "EXPOSURE_CAP",
              "productLine": "*",
              "segment": "*",
              "amountAbove": null,
              "amountUpTo": "1000000.00",
              "levelCode": "L2"
            },
            {
              "entryNo": 2,
              "deviationType": "EXPOSURE_CAP",
              "productLine": "*",
              "segment": "*",
              "amountAbove": "1000000.00",
              "amountUpTo": null,
              "levelCode": "L3"
            }
          ]
        }
      },
      "settings": {
        "authorityAmount": "application.requestedAmount"
      },
      "rules": [
        {
          "code": "P_FAIL_RULE",
          "name": "A rule that fails",
          "scope": "APPLICATION",
          "check": "application.one < 0",
          "onFail": {
            "status": "FAIL",
            "reasonCode": "KO_PRECEDENCE_FAIL"
          },
          "onMissing": {
            "policy": "REFER"
          },
          "outputs": {}
        },
        {
          "code": "P_ERROR_RULE",
          "name": "A rule that divides by zero",
          "scope": "APPLICATION",
          "check": "application.one / application.zero <= 1",
          "onFail": {
            "status": "FAIL",
            "reasonCode": "KO_PRECEDENCE_ERROR"
          },
          "onMissing": {
            "policy": "REFER"
          },
          "outputs": {}
        },
        {
          "code": "P_DEVIATION_RULE",
          "name": "A rule that deviates",
          "scope": "APPLICATION",
          "check": "application.exposure <= 200000",
          "onFail": {
            "status": "DEVIATION",
            "reasonCode": "POL_EXPOSURE_CAP",
            "deviationType": "EXPOSURE_CAP",
            "measure": "application.exposure",
            "worseWhen": "HIGHER"
          },
          "onMissing": {
            "policy": "REFER"
          },
          "outputs": {}
        }
      ],
      "flow": {
        "stages": [
          {
            "name": "ELIGIBILITY",
            "knockout": false,
            "steps": [
              {
                "ref": "P_FAIL_RULE",
                "aggregate": {
                  "kind": "WORST"
                }
              },
              {
                "ref": "P_ERROR_RULE",
                "aggregate": {
                  "kind": "WORST"
                }
              },
              {
                "ref": "P_DEVIATION_RULE",
                "aggregate": {
                  "kind": "WORST"
                }
              }
            ]
          }
        ]
      }
    },
    "expect": {
      "decision": "DECLINE"
    }
  },
