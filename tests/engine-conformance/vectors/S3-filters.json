  {
    "id": "S3-02",
    "description": "a total predicate such as isMissing(it.status) or it.status = \"ACTIVE\" is never unknown, so the filter yields both elements and the sum is 30; this is how an author handles elements with missing values explicitly (CHK-019)",
    "asOf": "2026-10-01",
    "scope": "MEMBER",
    "facts": {
      "member": {
        "tradelines": [
          {
            "status": "ACTIVE",
            "currentBalance": "10"
          },
          {
            "currentBalance": "20"
          }
        ]
      }
    },
    "expr": "sum(member.tradelines[isMissing(it.status) or it.status = \"ACTIVE\"].currentBalance)",
    "expect": {
      "value": {
        "decimal": "30"
      }
    }
  },
  {
