                "aggregate": {
                  "kind": "WORST"
                }
              },
              {
                "ref": "MFI_INDEBTEDNESS_CAP",
                "aggregate": {
                  "kind": "THRESHOLD",
                  "metric": "PERCENT",
                  "op": ">=",
                  "value": "param.GROUP_DEVIATION_SHARE_REFER_PCT",
                  "statuses": [
                    "DEVIATION"
                  ],
                  "result": "REFER"
                }
              }
            ]
          },
