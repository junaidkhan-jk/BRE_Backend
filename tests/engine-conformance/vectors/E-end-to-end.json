            }
          ]
        }
      },
      "settings": {
        "authorityAmount": "coalesce(application.approvedAmount, application.recommendedAmount, application.requestedAmount)",
        "customerReasonLimit": 4,
        "fuelLimit": 1000000
      },
      "variables": [
        {
          "name": "memberUnsecuredOutstanding",
          "type": "Decimal",
          "scope": "MEMBER",
          "expr": "sum(member.bureauReports.tradelines[it.accountType in list.UNSECURED_ACCOUNT_TYPES and it.status in list.OPEN_TRADELINE_STATUSES].currentBalance)",
          "description": "Outstanding on open unsecured tradelines across all bureau reports of the member"
        },
        {
          "name": "proposedAmount",
          "type": "Decimal",
          "scope": "APPLICATION",
          "expr": "coalesce(application.approvedAmount, application.recommendedAmount, application.requestedAmount)"
        }
      ],
      "rules": [
        {
          "code": "MFI_INDEBTEDNESS_CAP",
          "name": "Member indebtedness within cap",
          "scope": "MEMBER",
          "when": "true",
          "check": "memberUnsecuredOutstanding + proposedAmount / count(group.memberPartyRefs) <= param.INDEBTEDNESS_CAP",
          "onFail": {
            "status": "DEVIATION",
            "reasonCode": "AFF_INDEBTEDNESS_CAP",
            "deviationType": "INDEBTEDNESS_CAP",
            "measure": "memberUnsecuredOutstanding + proposedAmount / count(group.memberPartyRefs)",
            "worseWhen": "HIGHER"
          },
          "onMissing": {
            "policy": "REFER"
          },
          "outputs": {
            "totalIndebtedness": "memberUnsecuredOutstanding + proposedAmount / count(group.memberPartyRefs)"
          }
        },
        {
          "code": "SCREENING_HIT",
          "name": "No sanctions, PEP or negative-list hit",
          "scope": "PARTY",
          "check": "not (party.screening.sanctionsHit or party.screening.pepHit or party.screening.negativeListHit)",
          "onFail": {
            "status": "FAIL",
            "reasonCode": "KO_SCREENING_HIT"
          },
          "onMissing": {
            "policy": "REFER"
          },
          "outputs": {}
        }
      ],
      "decisionTables": [
        {
          "code": "GRP_VRM_CATEGORY",
          "name": "Village risk category",
          "scope": "GROUP",
          "hitPolicy": {
            "kind": "FIRST"
          },
          "inputs": [
            {
              "name": "vrm",
              "expr": "group.villageRiskCategory"
            }
          ],
          "outputs": [],
          "rows": [
            {
              "when": [
                "in [\"A\",\"B\"]"
              ],
              "then": {
                "status": "PASS"
              }
            },
            {
              "when": [
                "= \"C\""
              ],
              "then": {
                "status": "DEVIATION",
                "deviationType": "VRM_CATEGORY_C",
                "reasonCode": "POL_VRM_C"
              }
            },
            {
              "when": [
                "in [\"D\",\"E\"]"
              ],
              "then": {
                "status": "FAIL",
                "reasonCode": "POL_VRM_DE"
              }
            },
            {
              "when": [
                "missing"
              ],
              "then": {
                "status": "REFER",
                "reasonCode": "DATA_VRM_MISSING"
              }
            },
            {
              "when": [
                "-"
              ],
              "then": {
                "status": "REFER",
                "reasonCode": "POL_VRM_UNKNOWN"
              }
            }
          ],
          "onMissing": {
            "policy": "REFER"
          }
        }
      ],
      "scorecards": [
        {
          "code": "MFI_APP_SCORE_V1",
          "name": "MFI application score v1",
          "scope": "MEMBER",
          "baseScore": 300,
          "characteristics": [
            {
              "name": "groupCycle",
              "expr": "group.cycleNumber",
              "reasonCode": "SC_CYCLE_LOW",
              "bins": [
                {
                  "when": "= 1",
                  "points": 20
                },
                {
                  "when": "[2..3]",
                  "points": 45
                },
                {
                  "when": ">= 4",
                  "points": 70
                },
                {
                  "when": "missing",
                  "points": 0,
                  "reasonCode": "SC_CYCLE_MISSING"
                }
              ]
            }
          ],
          "adverseReasons": 3,
          "scaling": {
            "multiplier": "1",
            "offset": "0",
            "scale": 0,
            "roundingMode": "HALF_UP"
          },
          "onMissing": {
            "policy": "REFER"
          }
        }
      ],
      "flow": {
        "stages": [
          {
            "name": "KNOCKOUT",
            "knockout": true,
            "steps": [
              {
                "ref": "SCREENING_HIT",
                "roles": [
                  "MEMBER"
                ],
                "aggregate": {
                  "kind": "WORST"
                }
              }
            ]
          },
          {
            "name": "ELIGIBILITY",
            "knockout": false,
            "steps": [
              {
                "ref": "GRP_VRM_CATEGORY",
                "aggregate": {
                  "kind": "WORST"
                }
              },
              {
                "ref": "MFI_INDEBTEDNESS_CAP",
                "aggregate": {
                  "kind": "THRESHOLD",
                  "metric": "PERCENT",
                  "op": ">=",
                  "value": "param.GROUP_DEVIATION_SHARE_REFER_PCT",
                  "statuses": [
                    "DEVIATION"
                  ],
                  "result": "REFER"
                }
              }
            ]
          },
          {
            "name": "SCORING",
            "knockout": false,
            "steps": [
              {
                "ref": "MFI_APP_SCORE_V1",
                "aggregate": {
                  "kind": "NONE"
                }
              }
            ]
          }
        ]
      }
    },
