  {
    "id": "S5-04",
    "description": "a gap reached with every input present is ERROR EVAL_TABLE_NO_MATCH, never onMissing: rows [in [\"A\",\"B\"]] and [= \"C\"] with input \"F\" leave no matching row, a gap CHK-002 should already have rejected at compile time",
    "asOf": "2026-10-01",
    "scope": "GROUP",
    "facts": {
      "group": {
        "groupRef": "G-0001",
        "villageRiskCategory": "F"
      }
    },
    "policy": {
      "decisionTables": [
