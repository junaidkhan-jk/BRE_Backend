      "value": {
        "decimal": "0.6666666667"
      }
    }
  },
  {
    "id": "D-03b",
    "description": "1 / 3 * 3 = 1 is FALSE: division to scale 10 gives 0.9999999999, and the engine does not pretend otherwise",
    "asOf": "2026-10-01",
    "expr": "1 / 3 * 3 = 1",
    "expect": {
      "value": {
        "bool": false
      }
    }
  },
  {
    "id": "D-03c",
    "description": "1 / 3 * 3 is 0.9999999999, the value that makes D-03b FALSE",
    "asOf": "2026-10-01",
    "expr": "1 / 3 * 3",
    "expect": {
      "value": {
        "decimal": "0.9999999999"
      }
    }
  },
