    "asOf": "2026-10-01",
    "expr": "round(0.500004, 2, HALF_UP) <= 0.5",
    "expect": {
      "value": {
        "bool": true
      }
    }
  },
  {
    "id": "D-03a",
    "description": "2 / 3 divides to scale 10 HALF_EVEN",
    "asOf": "2026-10-01",
