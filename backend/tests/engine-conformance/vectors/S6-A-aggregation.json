          "role": "MEMBER",
          "type": "INDIVIDUAL",
          "proposedAmount": "50000",
          "income": {
            "monthlyNet": "15000"
          }
        }
      ]
    },
    "policy": {
      "rules": [
        {
          "code": "MFI_INCOME_FLOOR",
          "name": "Member net monthly income above the floor",
          "scope": "MEMBER",
          "when": "member.proposedAmount > 0",
