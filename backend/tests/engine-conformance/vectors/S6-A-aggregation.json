[
  {
    "id": "S6-01a",
    "description": "WORST over [PASS, DATA_MISSING, DEVIATION] is DATA_MISSING: severity is FAIL 6 > ERROR 5 > DATA_MISSING 4 > REFER 3 > DEVIATION 2 > PASS 1 > NOT_APPLICABLE 0, so a missing fact outranks a deviation",
    "asOf": "2026-10-01",
    "scope": "MEMBER",
    "facts": {
      "group": {
        "groupRef": "G-0001",
        "memberPartyRefs": [
          "P-0001",
          "P-0002",
          "P-0003"
        ]
      },
      "parties": [
        {
          "partyRef": "P-0001",
          "role": "MEMBER",
          "type": "INDIVIDUAL",
          "proposedAmount": "50000",
          "income": {
            "monthlyNet": "20000"
          }
        },
        {
          "partyRef": "P-0002",
          "role": "MEMBER",
          "type": "INDIVIDUAL",
          "proposedAmount": "50000",
          "income": {}
        },
        {
          "partyRef": "P-0003",
          "role": "MEMBER",
          "type": "INDIVIDUAL",
          "proposedAmount": "50000",
          "income": {
            "monthlyNet": "5000"
          }
        }
      ]
    },
    "policy": {
      "rules": [
        {
          "code": "MFI_INCOME_FLOOR",
          "name": "Member net monthly income above the floor",
          "scope": "MEMBER",
          "when": "member.proposedAmount > 0",
          "check": "member.income.monthlyNet >= 10000",
          "onFail": {
            "status": "DEVIATION",
            "reasonCode": "AFF_INCOME_FLOOR",
            "deviationType": "INCOME_FLOOR",
            "measure": "member.income.monthlyNet",
            "worseWhen": "LOWER"
          },
          "onMissing": {
            "policy": "REFER"
          },
          "outputs": {}
        }
      ],
      "flow": {
        "stages": [
          {
            "name": "ELIGIBILITY",
            "knockout": false,
            "steps": [
              {
                "ref": "MFI_INCOME_FLOOR",
                "aggregate": {
                  "kind": "WORST"
                }
              }
            ]
          }
        ]
      }
    },
    "expect": {
      "steps": [
        {
          "status": "DATA_MISSING",
          "ref": "MFI_INCOME_FLOOR"
        }
      ]
    }
  },
  {
    "id": "S6-01b",
    "description": "WORST over [ERROR, FAIL] is FAIL: FAIL has severity 6 and ERROR 5, so an evaluation error does not mask a policy failure",
    "asOf": "2026-10-01",
    "scope": "MEMBER",
    "facts": {
      "group": {
        "groupRef": "G-0001",
        "memberPartyRefs": [
          "P-0001",
          "P-0002"
        ]
      },
      "parties": [
        {
          "partyRef": "P-0001",
          "role": "MEMBER",
          "type": "INDIVIDUAL",
          "proposedAmount": "0",
          "income": {
            "monthlyNet": "20000"
          }
        },
        {
          "partyRef": "P-0002",
          "role": "MEMBER",
          "type": "INDIVIDUAL",
          "proposedAmount": "50000",
          "income": {
            "monthlyNet": "100"
          }
        }
      ]
    },
    "policy": {
      "rules": [
        {
          "code": "MFI_INSTALMENT_RATIO",
          "name": "Member income covers at least a tenth of the proposed amount",
          "scope": "MEMBER",
          "check": "member.income.monthlyNet / member.proposedAmount >= 0.1",
          "onFail": {
            "status": "FAIL",
            "reasonCode": "AFF_RATIO_LOW"
          },
          "onMissing": {
            "policy": "REFER"
          },
          "outputs": {}
        }
      ],
      "flow": {
        "stages": [
          {
            "name": "ELIGIBILITY",
            "knockout": false,
            "steps": [
              {
                "ref": "MFI_INSTALMENT_RATIO",
                "aggregate": {
                  "kind": "WORST"
                }
              }
            ]
          }
        ]
      }
    },
    "expect": {
      "steps": [
        {
          "status": "FAIL",
          "ref": "MFI_INSTALMENT_RATIO"
        }
      ]
    }
  },
