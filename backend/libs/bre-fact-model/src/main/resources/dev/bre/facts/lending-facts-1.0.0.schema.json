{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bre.dev/schemas/facts/lending-facts-1.0.0.json",
  "title": "BRE canonical lending facts v1",
  "description": "00 \u00a73.9. Every leaf carries the \u00a79.1 vendor keywords: x-bre-tags, x-bre-group and x-bre-mask. Money is a decimal in INR carried as a string (\u00a72.1 rule 4), never a JSON number.",
  "type": "object",
  "required": [
    "application",
    "parties",
    "consent"
  ],
  "properties": {
    "application": {
      "type": "object",
      "required": [
        "applicationRef",
        "productLine",
        "productCode",
        "stage",
        "channel",
        "requestedAmount",
        "tenureMonths",
        "purpose"
      ],
      "properties": {
        "applicationRef": {
          "type": "string",
          "x-bre-tags": [
            "pii"
          ],
          "x-bre-group": "identifying",
          "x-bre-mask": "TOKEN_TAIL4"
        },
        "productLine": {
          "type": "string"
        },
        "productCode": {
          "type": "string"
        },
        "stage": {
          "type": "string"
        },
        "segment": {
          "type": "string"
        },
        "channel": {
          "type": "string"
        },
        "branchCode": {
          "type": "string"
        },
        "requestedAmount": {
          "type": "string",
          "x-bre-decimal": true,
          "x-bre-mask": "ROUND_1000"
        },
        "recommendedAmount": {
          "type": "string",
          "x-bre-decimal": true,
          "x-bre-mask": "ROUND_1000"
        },
        "approvedAmount": {
          "type": "string",
          "x-bre-decimal": true,
          "x-bre-mask": "ROUND_1000"
        },
        "tenureMonths": {
          "type": "integer"
        },
        "repaymentFrequency": {
          "type": "string",
          "enum": [
            "WEEKLY",
            "FORTNIGHTLY",
            "MONTHLY",
            "QUARTERLY"
          ]
        },
        "proposedMonthlyInstalment": {
          "type": "string",
          "x-bre-decimal": true
        },
        "emiPerLakh": {
          "type": "string",
          "x-bre-decimal": true
        },
        "purpose": {
          "type": "string"
        },
        "asOf": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "parties": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "partyRef",
          "role",
          "type"
        ],
        "properties": {
          "partyRef": {
            "type": "string",
            "x-bre-tags": [
              "pii"
            ],
            "x-bre-group": "identifying",
            "x-bre-mask": "TOKEN_TAIL4"
          },
          "principalRef": {
            "description": "The caller's stable pseudonymous ID for the data principal; targets erasure and crypto-shredding. Must never be a natural identifier (00 \u00a73.9).",
            "type": "string",
            "x-bre-tags": [
              "pii"
            ],
            "x-bre-group": "identifying",
            "x-bre-mask": "HIDE"
          },
          "role": {
            "type": "string",
            "enum": [
              "APPLICANT",
              "CO_APPLICANT",
              "GUARANTOR",
              "PROMOTER",
              "DIRECTOR",
              "MEMBER"
            ]
          },
          "type": {
            "type": "string",
            "enum": [
              "INDIVIDUAL",
              "NON_INDIVIDUAL"
            ]
          },
          "dateOfBirth": {
            "type": "string",
            "format": "date",
            "x-bre-tags": [
              "pii"
            ],
            "x-bre-group": "identifying",
            "x-bre-mask": "AGE_BAND"
          },
          "gender": {
            "description": "PROTECTED. Reading this from rule logic is BEL-017 without an approved governance override.",
            "type": "string",
            "enum": [
              "F",
              "M",
              "X"
            ],
            "x-bre-tags": [
              "pii",
              "protected"
            ],
            "x-bre-group": "identifying",
            "x-bre-mask": "HIDE"
          },
          "religion": {
            "description": "PROTECTED, and never a lending criterion.",
            "type": "string",
            "x-bre-tags": [
              "pii",
              "protected"
            ],
            "x-bre-group": "identifying",
            "x-bre-mask": "HIDE"
          },
          "caste": {
            "description": "PROTECTED, and never a lending criterion.",
            "type": "string",
            "x-bre-tags": [
              "pii",
              "protected"
            ],
            "x-bre-group": "identifying",
            "x-bre-mask": "HIDE"
          },
          "aadhaarVaultRef": {
            "description": "A vault reference, never a raw Aadhaar number (00 \u00a73.9). Tagged aadhaar: rule logic may not read it at all (BEL-026), with no override.",
            "type": "string",
            "x-bre-tags": [
              "pii",
              "regulated",
              "aadhaar"
            ],
            "x-bre-group": "identifying",
            "x-bre-mask": "HIDE"
          },
          "panToken": {
            "type": "string",
            "pattern": "^tok_[A-Za-z0-9]{16,64}$",
            "x-bre-tags": [
              "pii",
              "regulated"
            ],
            "x-bre-group": "identifying",
            "x-bre-mask": "TOKEN_TAIL4"
          },
          "householdRef": {
            "type": "string"
          },
          "proposedAmount": {
            "type": "string",
            "x-bre-decimal": true
          },
          "proposedMonthlyInstalment": {
            "type": "string",
            "x-bre-decimal": true
          },
          "kyc": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "VERIFIED",
                  "PENDING",
                  "FAILED"
                ],
                "x-bre-tags": [
                  "regulated"
                ]
              },
              "verifiedAt": {
                "type": "string",
                "format": "date-time",
                "x-bre-tags": [
                  "regulated"
                ]
              },
              "method": {
                "type": "string",
                "x-bre-tags": [
                  "regulated"
                ]
              }
            }
          },
          "income": {
            "type": "object",
            "properties": {
              "monthlyGross": {
                "type": "string",
                "x-bre-decimal": true,
                "x-bre-tags": [
                  "pii"
                ],
                "x-bre-group": "identifying",
                "x-bre-mask": "ROUND_1000"
              },
              "monthlyNet": {
                "type": "string",
                "x-bre-decimal": true,
                "x-bre-tags": [
                  "pii"
                ],
                "x-bre-group": "identifying",
                "x-bre-mask": "ROUND_1000"
              },
              "verified": {
                "type": "boolean"
              },
              "source": {
                "type": "string"
              }
            }
          },
          "declaredObligations": {
            "type": "array",
