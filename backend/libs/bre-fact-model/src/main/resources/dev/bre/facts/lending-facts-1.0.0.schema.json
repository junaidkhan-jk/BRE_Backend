                "bureau": {
                  "type": "string",
                  "x-bre-tags": [
                    "regulated"
                  ]
                },
                "scoreType": {
                  "type": "string",
                  "x-bre-tags": [
                    "regulated"
                  ]
                },
                "score": {
                  "type": "integer",
                  "x-bre-tags": [
                    "regulated"
                  ],
                  "x-bre-mask": "NONE"
                },
                "noHit": {
                  "type": "boolean",
                  "x-bre-tags": [
                    "regulated"
                  ]
                },
                "pulledAt": {
                  "type": "string",
                  "format": "date-time",
                  "x-bre-tags": [
                    "regulated"
                  ]
                },
                "tradelines": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "lenderRef": {
                        "type": "string",
                        "x-bre-tags": [
                          "regulated"
                        ]
                      },
                      "accountType": {
                        "type": "string",
                        "x-bre-tags": [
                          "regulated"
                        ]
                      },
                      "lenderType": {
                        "type": "string",
                        "x-bre-tags": [
                          "regulated"
                        ]
                      },
                      "ownership": {
                        "type": "string",
                        "x-bre-tags": [
                          "regulated"
                        ]
                      },
                      "sanctionedAmount": {
                        "type": "string",
                        "x-bre-decimal": true,
                        "x-bre-tags": [
                          "regulated"
                        ]
                      },
                      "currentBalance": {
                        "type": "string",
                        "x-bre-decimal": true,
                        "x-bre-tags": [
                          "regulated"
                        ]
                      },
                      "instalmentAmount": {
                        "type": "string",
                        "x-bre-decimal": true,
                        "x-bre-tags": [
                          "regulated"
                        ]
                      },
                      "overdueAmount": {
                        "type": "string",
                        "x-bre-decimal": true,
                        "x-bre-tags": [
                          "regulated"
                        ]
                      },
                      "status": {
                        "type": "string",
                        "x-bre-tags": [
                          "regulated"
                        ]
                      },
                      "openedOn": {
                        "type": "string",
                        "format": "date",
                        "x-bre-tags": [
                          "regulated"
                        ]
                      },
                      "closedOn": {
                        "type": "string",
                        "format": "date",
                        "x-bre-tags": [
                          "regulated"
                        ]
                      },
                      "reportedOn": {
                        "type": "string",
                        "format": "date",
                        "x-bre-tags": [
                          "regulated"
                        ]
                      },
                      "dpdHistory": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "month": {
                              "type": "string",
                              "x-bre-tags": [
                                "regulated"
                              ],
                              "x-bre-mask": "MONTH_ONLY"
                            },
                            "dpd": {
                              "type": "integer",
                              "x-bre-tags": [
                                "regulated"
                              ]
                            }
                          }
