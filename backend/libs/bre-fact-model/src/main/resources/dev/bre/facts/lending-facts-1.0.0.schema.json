          "ownerPartyRefs": {
            "type": "array",
            "items": {
              "type": "string",
              "x-bre-tags": [
                "pii"
              ],
              "x-bre-group": "identifying"
            }
          },
          "ext": {
            "description": "Open extension map (00 \u00a73.9). Deliberately unconstrained: a caller may send anything here, so the validator does not report unknown paths beneath it. It IS still scanned for prohibited data \u2014 \u00a79.1 says the scan covers 'every string in the facts, including ext', and an open map is precisely where an unvalidated identifier ends up.",
            "type": "object",
            "additionalProperties": true
          }
        }
      }
