    "deviationApprovals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ruleCode": {
            "type": "string"
          },
          "deviationType": {
            "type": "string"
          },
          "entityType": {
            "type": "string"
          },
          "entityRef": {
            "type": "string"
          },
          "approvedValue": {
            "type": "string"
          },
          "approvedBy": {
            "type": "string",
            "x-bre-tags": [
