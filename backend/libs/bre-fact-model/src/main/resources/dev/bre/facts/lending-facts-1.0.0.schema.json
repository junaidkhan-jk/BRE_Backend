                },
                "enquiries": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "date": {
                        "type": "string",
                        "format": "date",
                        "x-bre-tags": [
                          "regulated"
                        ]
                      },
                      "purpose": {
                        "type": "string",
                        "x-bre-tags": [
                          "regulated"
                        ]
                      },
                      "amount": {
                        "type": "string",
                        "x-bre-decimal": true,
                        "x-bre-tags": [
                          "regulated"
                        ]
                      }
                    }
                  }
                }
              }
            }
          },
          "screening": {
            "type": "object",
            "properties": {
              "sanctionsHit": {
                "type": "boolean",
                "x-bre-tags": [
                  "regulated"
                ]
              },
              "pepHit": {
                "type": "boolean",
                "x-bre-tags": [
                  "regulated"
                ]
              },
              "negativeListHit": {
                "type": "boolean",
                "x-bre-tags": [
                  "regulated"
                ]
              },
              "matchScore": {
                "type": "string",
                "x-bre-decimal": true,
                "x-bre-tags": [
                  "regulated"
                ]
              }
            }
          },
          "ext": {
            "description": "Open extension map (00 \u00a73.9). Deliberately unconstrained: a caller may send anything here, so the validator does not report unknown paths beneath it. It IS still scanned for prohibited data \u2014 \u00a79.1 says the scan covers 'every string in the facts, including ext', and an open map is precisely where an unvalidated identifier ends up.",
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "group": {
      "type": "object",
      "properties": {
        "groupRef": {
          "type": "string"
