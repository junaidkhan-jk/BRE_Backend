        "memberPartyRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "x-bre-tags": [
              "pii"
            ],
            "x-bre-group": "identifying"
          }
        },
        "meetingFrequency": {
          "type": "string"
        },
        "centreRef": {
          "type": "string"
        },
        "villageRiskCategory": {
          "type": "string",
          "enum": [
            "A",
            "B",
            "C",
            "D",
            "E"
          ]
